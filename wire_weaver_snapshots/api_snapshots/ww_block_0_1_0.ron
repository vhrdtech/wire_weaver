            (ident: "lease", ty: NumericAny(Base(U32))),
        ], return_ty: Some(Result(ok_ty: Tuple([]), err_ty: OutOfLine(type_idx: 4))), errors: Some([
            (ident: "BadLease", nested: None),
        ])), multiplicity: Flat, since: None, ident: "release", docs: [
            "Gives the card back: its user mounts it again (and finds what the host wrote). `BadLease` for a lease that",
            "lapsed or is not the current one.",
        ], optional: None, meta: None),
        (id: 5, kind: Method(args: [
            (ident: "lease", ty: NumericAny(Base(U32))),
            (ident: "lba", ty: NumericAny(Base(U64))),
            (ident: "data", ty: MaxLen(max_len: Fixed(4096), ty: Vec(NumericAny(Base(U8))))),
