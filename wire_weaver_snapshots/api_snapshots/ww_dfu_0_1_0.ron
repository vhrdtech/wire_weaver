        ]), discriminant: 0, since: None),
        (docs: [
            "One app slot, updated in place: from a stored plan by the bootloader (mode 2) or live by an updater (mode 3).",
            "No revert.",
        ], ident: "InPlace", fields: Unit, discriminant: 1, since: None),
    ], path: None, instance_of: None, future_version: Some(Off))), crate_idx: 0),
    InLine(ty: Enum((size: SelfDescribing, repr: Nibble, crate_idx: 0, docs: [
