    (id: 3, kind: Trait(trait_idx: 3, omitted: None), multiplicity: Flat, since: None, ident: "Stage", docs: [], optional: None, meta: None),
    (id: 4, kind: Trait(trait_idx: 4, omitted: None), multiplicity: Flat, since: None, ident: "StageBulk", docs: [], optional: None, meta: None),
