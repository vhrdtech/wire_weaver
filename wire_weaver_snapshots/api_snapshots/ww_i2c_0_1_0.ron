        ], optional: Some((group: Some("slave"))), meta: None),
        (id: 15, kind: Method(args: [], return_ty: Some(NumericAny(Base(U32))), errors: None), multiplicity: Flat, since: None, ident: "slave_clear_answers", docs: [
