    InLine(ty: Struct((size: Unsized, crate_idx: 0, docs: [
        "`MIN ..= MAX` for an integer storage up to 64 bits (`u8`..`u64`, `i8`..`i64`, `UNib32`, `UVlq32`, `UVlq64`,",
