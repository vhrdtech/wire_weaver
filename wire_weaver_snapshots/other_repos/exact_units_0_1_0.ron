    InLine(ty: Struct((size: Unsized, crate_idx: 0, docs: [
        "Every finite float, neither ±∞ nor NaN: a float (`f32`, `f64`) that must stay a number. [Unbounded] keeps ±∞ (the",
        "VSWR of a total reflection, an `f32` that overflows), `Finite` says the value can\'t be one. The ends are `T::MIN`",
        "and `T::MAX`, the largest finite floats, so [contains](Bounds::contains) refuses ±∞ and NaN.",
        "",
        "A bounded type: no `new` and no `+`, `-`, `*` or `/`, [try_new](super::Fixed::try_new) and the `const fn`",
        "[bounded](super::Fixed::bounded) make one, `checked_*` is `None` where the result is ±∞ or NaN, the wire, serde",
        "and text refuse both. A float `Fixed<_, _, f32>` goes over with [to_bounds](super::Fixed::to_bounds), and back",
        "with [unbounded](super::Fixed::unbounded). Only for floats: `Fixed<_, _, u16, Finite>` doesn\'t compile.",
        "",
        "```",
        "use exact_units::{Finite, Fixed, OutOfBounds, prefix::One, units::Volt};",
        "",
        "type V = Fixed<Volt, One, f32, Finite>;",
        "const LIMIT: V = V::bounded(3.3);",
        "assert_eq!(V::try_new(f32::INFINITY), Err(OutOfBounds));",
        "assert_eq!(V::try_new(f32::NAN), Err(OutOfBounds));",
        "let big = V::bounded(f32::MAX);",
        "assert_eq!(big.checked_add(big), None); // the sum is +∞",
        "assert_eq!(LIMIT.checked_add(LIMIT).map(V::get), Some(6.6));",
        "let inf = Fixed::<Volt, One, f32>::bounded(f32::INFINITY);",
        "assert_eq!(inf.to_bounds::<Finite>(), Err(OutOfBounds));",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Finite, Fixed, prefix::One, units::Volt};",
        "",
        "type V = Fixed<Volt, One, f32, Finite>;",
        "const INF: V = V::bounded(f32::INFINITY); // a compile error in const code",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Finite, Fixed, prefix::One, units::Volt};",
        "",
        "let v = Fixed::<Volt, One, f32, Finite>::bounded(1.0);",
        "let _ = v + v; // a bounded type: checked_add",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Finite, Fixed, prefix::One, units::Volt};",
        "",
        "let _ = Fixed::<Volt, One, u16, Finite>::try_new(1); // only for floats",
        "```",
    ], ident: "Finite", generics: [], fields: Unit, sparse: false, path: None, instance_of: None, extra: None)), crate_idx: 0),
    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A value in unit `U` and prefix `P`, stored as `T`, within the bounds `B`: on the wire exactly `T`, the unit,",
        "prefix and bounds are only in the type. `shared_us: u64` becomes `shared: Fixed<Second, Micro, u64>` (or",
        "[Micros]`<u64>`) with the same bytes, and introspection shows `µs`.",
        "",
        "Where a `ww_si::Quantity` lets the device pick prefix and number type per value (and sends both), a `Fixed` has them fixed",
        "by the API: no prefix on the wire, no `NumericValue` on the device, so a `u64` here doesn\'t turn on `ww_numeric`\'s",
        "`u64` for the whole firmware.",
        "",
        "```",
        "use exact_units::{Fixed, Micros, prefix::{Micro, Milli}, units::Second};",
        "",
        "let t: Micros<u32> = Fixed::new(1500);",
        "assert_eq!(format!(\"{t}\"), \"1500 µs\");",
        "assert_eq!(format!(\"{t:#}\"), \"0.0015 s\");",
        "// exact conversions only: 1500 µs is not a whole number of ms",
        "assert_eq!(t.to::<Milli, u16>(), None);",
        "assert_eq!((t * 2).to::<Milli, u16>(), Some(Fixed::new(3)));",
        "assert_eq!(core::time::Duration::from(t), core::time::Duration::from_micros(1500));",
        "```",
        "",
        "`B` is [Unbounded] unless given, and stays out of the way then: `Fixed::new` and the operators exist for the",
        "three-parameter form. A bounded value is made with [try_new](Self::try_new) or [bounded](Self::bounded) and checked",
        "on every read from the wire:",
        "",
        "```",
        "use exact_units::{Fixed, Range, prefix::Milli, units::Second};",
        "",
        "type Timeout = Fixed<Second, Milli, u16, Range<1, 5000>>;",
        "assert!(Timeout::try_new(10).is_ok());",
        "assert!(Timeout::try_new(0).is_err());",
        "const LONG: Timeout = Timeout::bounded(5000);",
        "assert_eq!(LONG.get(), 5000);",
        "```",
        "",
        "A bound that doesn\'t fit the storage doesn\'t build:",
        "",
        "```compile_fail",
        "use exact_units::{Fixed, Range, prefix::One, units::Ratio};",
        "",
        "let _ = Fixed::<Ratio, One, u8, Range<-5, 300>>::try_new(5);",
        "```",
    ], ident: "Fixed", generics: [
        (ident: "U", kind: Type),
        (ident: "P", kind: Type),
        (ident: "T", kind: Type),
        (ident: "B", kind: Type),
    ], fields: Named([
        (ident: Some("value"), default: None, since: None, ty: Param(2), docs: [
            "The number of steps of `P`.",
        ], slot: None, series_opaque: false),
    ]), sparse: false, path: None, instance_of: None, extra: Some((transparent: true, marker: None)))), crate_idx: 0),
    InLine(ty: Struct((size: Unsized, crate_idx: 0, docs: [
        "No bounds, and NaN allowed: a float (`f32`, `f64`) that may be NaN. It is what `+`, `-`, `*` and `/` of a float",
        "give, the float\'s own IEEE 754 operation without a check, and a value that is NaN on purpose (\"no reading\").",
        "",
        "Every compare with NaN is false, so `if temp > limit { shutdown() }` would silently not trip. A `MaybeNan` has no",
        "`<`, `>` or `==`: it compares through a method that names what NaN gives ([gt_or](super::Fixed::gt_or) and its",
        "kin), or after [not_nan](super::Fixed::not_nan), which is `None` for NaN.",
        "",
        "```",
        "use exact_units::{Fixed, prefix::One, units::Volt};",
        "",
        "let inf = Fixed::<Volt, One, f32>::bounded(f32::INFINITY);",
        "let nan = inf - inf; // a MaybeNan",
        "assert!(nan.get().is_nan());",
        "assert_eq!(nan.not_nan(), None);",
        "assert!(nan.gt_or(inf, true)); // NaN counts as past the limit here",
        "assert_eq!((inf + inf).not_nan(), Some(inf));",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Fixed, prefix::One, units::Volt};",
        "",
        "let v = Fixed::<Volt, One, f32>::bounded(1.0);",
        "let _ = v + v > v; // a MaybeNan has no `>`: gt_or, or not_nan first",
        "```",
    ], ident: "MaybeNan", generics: [], fields: Unit, sparse: false, path: None, instance_of: None, extra: Some((transparent: false, marker: Some(MaybeNan))))), crate_idx: 0),
    InLine(ty: Struct((size: Unsized, crate_idx: 0, docs: [
        "A value outside its [Bounds], or one that doesn\'t fit the storage.",
