            "Mass, kilogram.",
        ], slot: None, series_opaque: false),
        (ident: Some("a"), default: None, since: None, ty: NumericAny(Base(IB(4))), docs: [
            "Electric current, ampere.",
        ], slot: None, series_opaque: false),
        (ident: Some("k"), default: None, since: None, ty: NumericAny(Base(IB(4))), docs: [
