    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A 0-based position in a table of `Of`, stored as `T` within the bounds `B`: `Index<Sample, u32>` is a sample\'s",
        "place in a capture, `Index<Byte, u32>` an offset. On the wire exactly the `T`.",
        "",
        "```",
        "use exact_units::{Fixed, Index, units::Sample};",
        "",
        "let start = Index::<Sample, u32>::new(100);",
        "let end = start + Fixed::new(50);",
        "assert_eq!(end.get(), 150);",
        "// two positions are apart by an amount of samples",
        "assert_eq!(end - start, Fixed::new(50));",
        "assert!(start < end);",
        "```",
        "",
        "Bounds are those of [Fixed]: a table of 8 is `Range<0, 7>`, checked on construction and on every read from the",
        "wire, and moving a bounded index is `checked_add` / `checked_sub`.",
        "",
        "```",
        "use exact_units::{Fixed, Index, Range, units::Item};",
        "",
        "type Slot = Index<Item, u8, Range<0, 7>>;",
        "let last = Slot::try_new(7).unwrap();",
        "assert!(Slot::try_new(8).is_err());",
        "assert_eq!(last.checked_add(Fixed::new(1)), None);",
        "assert_eq!(last.checked_sub(Fixed::new(7)), Some(Slot::try_new(0).unwrap()));",
        "```",
        "",
        "Two indices don\'t add, an index doesn\'t scale, and indices of different tables don\'t mix:",
        "",
        "```compile_fail",
        "use exact_units::{Index, units::Sample};",
        "let _ = Index::<Sample, u32>::new(1) + Index::<Sample, u32>::new(2);",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Index, units::Sample};",
        "let _ = Index::<Sample, u32>::new(1) * 2;",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Fixed, Index, units::{Frame, Sample}};",
        "let _ = Index::<Sample, u32>::new(1) + Fixed::<Frame, exact_units::prefix::One, u32>::new(2);",
        "```",
    ], ident: "Index", generics: [
        (ident: "Of", kind: Type),
        (ident: "T", kind: Type),
        (ident: "B", kind: Type),
    ], fields: Named([
        (ident: Some("index"), default: None, since: None, ty: Param(1), docs: [
            "The position, 0 the first.",
        ], slot: None, series_opaque: false),
    ]), sparse: false, path: None, instance_of: None, extra: Some((transparent: true, marker: None)))), crate_idx: 0),
    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A 1-based position in a table of `Of`, as people and datasheets count: channel 1 to 4, pin 1, motor 1 to 4. Never",
        "0: 0 is refused on construction and on reading from the wire. `B` bounds the number as shown (`Range<1, 4>` for",
        "four channels). On the wire exactly the `T`.",
        "",
        "```",
        "use exact_units::{Index, IndexFrom1, Range, units::Item};",
        "",
        "type Channel = IndexFrom1<Item, u8, Range<1, 4>>;",
        "let ch = Channel::try_new(3).unwrap();",
        "assert_eq!(ch.to_string(), \"3\");",
        "assert_eq!(ch.to_index(), Index::new(2));",
        "assert_eq!(Channel::from_index(Index::<Item, u8>::new(0)), Some(Channel::try_new(1).unwrap()));",
        "assert!(Channel::try_new(0).is_err());",
        "assert!(Channel::try_new(5).is_err());",
        "```",
    ], ident: "IndexFrom1", generics: [
        (ident: "Of", kind: Type),
        (ident: "T", kind: Type),
        (ident: "B", kind: Type),
    ], fields: Named([
        (ident: Some("number"), default: None, since: None, ty: Param(1), docs: [
            "The number, 1 the first.",
        ], slot: None, series_opaque: false),
    ]), sparse: false, path: None, instance_of: None, extra: Some((transparent: true, marker: None)))), crate_idx: 0),
    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A wrapping sequence number of `Of`, stored as `T`: a request\'s, an envelope\'s, a frame\'s (`Seq<Frame, u16>`,",
        "`Seq<Packet, Nibble>`). It moves on modulo 2^bits of `T` and compares in serial number order (RFC 1982): `a` is",
        "before `b` when `b` is less than half the range ahead of it, so the order holds across the wrap. On the wire",
        "exactly the `T`.",
        "",
        "```",
        "use exact_units::{Fixed, Seq, units::Frame};",
        "",
        "let a = Seq::<Frame, u8>::new(250);",
        "let b = a.wrapping_add(10);",
        "assert_eq!(b.get(), 4);",
        "assert!(a.is_before(b));",
        "assert!(b.is_after(a));",
        "assert_eq!(a.distance(b), Fixed::new(10));",
        "assert_eq!(a.next().get(), 251);",
        "```",
        "",
        "No `<` (integer order is wrong across the wrap), and two sequence numbers don\'t add:",
        "",
        "```compile_fail",
        "use exact_units::{Seq, units::Frame};",
        "let _ = Seq::<Frame, u8>::new(1) < Seq::<Frame, u8>::new(2);",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Seq, units::Frame};",
        "let _ = Seq::<Frame, u8>::new(1) + Seq::<Frame, u8>::new(2);",
        "```",
    ], ident: "Seq", generics: [
        (ident: "Of", kind: Type),
        (ident: "T", kind: Type),
    ], fields: Named([
        (ident: Some("seq"), default: None, since: None, ty: Param(1), docs: [
            "The sequence number.",
        ], slot: None, series_opaque: false),
    ]), sparse: false, path: None, instance_of: None, extra: Some((transparent: true, marker: None)))), crate_idx: 0),
    InLine(ty: Struct((size: Unsized, crate_idx: 0, docs: [
        "The pressure around the sensor, known only at run time: what gauge pressure is measured against.",
    ], ident: "AmbientPressure", generics: [], fields: Unit, sparse: false, path: None, instance_of: None, extra: Some((transparent: false, marker: Some(Reference((id: (crate_name: "exact_units", name: "AmbientPressure"), name: "ambient pressure", how: RunTime))))))), crate_idx: 0),
    InLine(ty: Struct((size: Unsized, crate_idx: 0, docs: [
        "Points that don\'t wrap.",
    ], ident: "Linear", generics: [], fields: Unit, sparse: false, path: None, instance_of: None, extra: None)), crate_idx: 0),
    InLine(ty: Struct((size: Unsized, crate_idx: 0, docs: [
        "Points that wrap around every `S` of the unit: `Modulo<One>` for [Turn](crate::units::Turn) (a turn),",
        "`Modulo<Rational<360, 1>>` for [Degree](crate::units::Degree). A point\'s number is kept in `[0, M)` for an",
        "unsigned storage and `[-M/2, M/2)` for a signed one, and point − point is the shortest way round, signed.",
        "",
        "A period of exactly `2^BITS` steps (a binary angle, [Bam16](crate::Bam16)) wraps in the storage\'s own wrapping",
        "arithmetic, any other (36000 steps of 0.01°) by `rem_euclid`. A period that isn\'t a whole number of steps doesn\'t",
        "compile:",
        "",
        "```compile_fail",
        "use exact_units::{Fixed, Point, origins::Angle, prefix::Rational, units::Degree};",
        "// 360° is not a whole number of 7° steps",
        "let a = Point::<Angle<Degree>, Fixed<Degree, Rational<7, 1>, u16>>::from_raw(1);",
        "let _ = a + Fixed::new(1);",
        "```",
    ], ident: "Modulo", generics: [
        (ident: "S", kind: Type),
    ], fields: Unnamed([]), sparse: false, path: None, instance_of: None, extra: None)), crate_idx: 0),
    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A signed exact number: how far an [Origin](super::Origin) lies from its reference\'s zero, in its unit. °C is",
        "`Offset::decimal(27315, -2)` K above 0 K, °F `Offset::ratio(45967, 180)` K (459.67 °R of 5/9 K each).",
        "",
        "Always canonical: zero is `magnitude: None` and never negative, so equal offsets are equal field by field. On the",
        "wire (`final_structure`): the sign bit, then the [Magnitude] behind an option bit; zero is 2 bits.",
    ], ident: "Offset", generics: [], fields: Named([
        (ident: Some("negative"), default: None, since: None, ty: Bool, docs: [
            "Below the reference; never for zero.",
        ], slot: None, series_opaque: false),
        (ident: Some("magnitude"), default: None, since: None, ty: Option(some_ty: OutOfLine(type_idx: 4)), docs: [
            "`None` for zero.",
        ], slot: None, series_opaque: false),
    ]), sparse: false, path: None, instance_of: None, extra: None)), crate_idx: 0),
    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A position against the origin `O`, its number a [Fixed] `F` in `O`\'s unit: `Point<Celsius, Fixed<Kelvin, Centi,",
        "i16>>` is a temperature in 0.01 °C, the same bytes as the `i16`.",
        "",
        "```",
        "use exact_units::{Fixed, Point, origins::{Celsius, Fahrenheit}, prefix::{Centi, Rational}, units::Kelvin};",
        "",
        "type DegC = Point<Celsius, Fixed<Kelvin, Centi, i16>>;",
        "type DegF = Point<Fahrenheit, Fixed<Kelvin, Rational<5, 9>, i16>>;",
        "let body = DegF::from_raw(98);",
        "assert_eq!(body.to_string(), \"98 °F\");",
        "// 98 °F is 36.666.. °C: not a whole number of 0.01 °C",
        "assert_eq!(body.to::<Celsius, Centi, i16>(), None);",
        "assert_eq!(DegF::from_raw(212).to::<Celsius, Centi, i16>(), Some(DegC::from_raw(10000)));",
        "// a vector between two points, a point and a vector",
        "let warmer = DegC::from_raw(2500) - DegC::from_raw(2000);",
        "assert_eq!(warmer, Fixed::new(500));",
        "assert_eq!((DegC::from_raw(2000) + warmer).to_string(), \"25 °C\");",
        "```",
        "",
        "Two points don\'t add, and a point doesn\'t scale:",
        "",
        "```compile_fail",
        "use exact_units::{Fixed, Point, origins::Celsius, prefix::Centi, units::Kelvin};",
        "type DegC = Point<Celsius, Fixed<Kelvin, Centi, i16>>;",
        "let _ = DegC::from_raw(2000) + DegC::from_raw(500);",
        "```",
        "",
        "```compile_fail",
        "use exact_units::{Fixed, Point, origins::Celsius, prefix::Centi, units::Kelvin};",
        "type DegC = Point<Celsius, Fixed<Kelvin, Centi, i16>>;",
        "let _ = DegC::from_raw(2000) * 2;",
        "```",
        "",
        "Gauge and absolute pressure have different references: no conversion without the ambient pressure.",
        "",
        "```compile_fail",
        "use exact_units::{Fixed, Point, origins::{Gauge, Vacuum}, prefix::Hecto, units::Pascal};",
        "let g = Point::<Gauge, Fixed<Pascal, Hecto, i32>>::from_raw(10);",
        "let _ = g.to::<Vacuum, Hecto, i32>();",
        "```",
    ], ident: "Point", generics: [
        (ident: "O", kind: Type),
        (ident: "F", kind: Type),
    ], fields: Named([
        (ident: Some("coord"), default: None, since: None, ty: Param(1), docs: [
            "The point\'s number: the amount from the origin.",
        ], slot: None, series_opaque: false),
    ]), sparse: false, path: None, instance_of: None, extra: Some((transparent: true, marker: None)))), crate_idx: 0),
