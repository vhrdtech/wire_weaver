        (ident: Some("g"), default: None, since: None, ty: NumericAny(Base(I8)), docs: [
            "Twice the exponent of G, the Newtonian constant of gravitation (measured).",
        ], slot: None, series_opaque: false),
    ]), sparse: false, path: None, instance_of: None, extra: None)), crate_idx: 0),
    InLine(ty: Struct((size: SelfDescribing, crate_idx: 0, docs: [
        "`prime^(exp/2)` in a [Magnitude]: a prime other than 2 and 5, and twice its exponent (never 0).",
