    InLine(ty: Struct((size: SelfDescribing, crate_idx: 0, docs: [
        "The part of a [Magnitude] after its power of 10: rarer, so it costs one bit on the wire when it is 1.",
    ], ident: "MagnitudeRest", generics: [], fields: Named([
        (ident: Some("pow2"), default: None, since: None, ty: NumericAny(Base(I8)), docs: [
            "Twice the exponent of 2.",
        ], slot: None, series_opaque: false),
        (ident: Some("symbols"), default: None, since: None, ty: Option(some_ty: OutOfLine(type_idx: 1)), docs: [
            "π, ln 2, ln 10, μ₀ and G, `None` when all their exponents are 0.",
        ], slot: None, series_opaque: false),
        (ident: Some("factors"), default: None, since: None, ty: Array(len: Fixed(16), ty: Option(some_ty: OutOfLine(type_idx: 2))), docs: [
