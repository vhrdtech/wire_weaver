    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A value of the unit `U`: a prefix and a number in whatever storage the device picks. The unit is only in the type,",
        "it takes no space on the wire or in RAM; `Quantity<units::Volt>` is written [Volt].",
        "",
        "On the wire the prefix (a `UNib32`, one nibble up to `Ronna`) and then the value with its number type",
        "(`final_structure`): `Volt::milli(3300u16)` is `12 e4 0c`. In a `Series` the prefix is a run and the value a",
        "numeric column that restarts where the prefix changes.",
        "",
        "```",
        "use ww_si::{Ampere, Volt, Watt};",
        "",
        "let v = Volt::milli(250u8);",
        "assert_eq!(v, Volt::base(0.25f32));",
        "assert_eq!(format!(\"{v}\"), \"250 mV\");",
        "assert_eq!(format!(\"{v:#}\"), \"0.25 V\");",
        "let p: Watt = v * Ampere::base(2u8);",
        "assert_eq!(p, Watt::base(0.5f32));",
        "```",
        "",
        "Units that don\'t go together don\'t build. Only products in the table multiply:",
        "",
        "```compile_fail",
        "use ww_si::{AngularVelocity, Volt};",
        "",
        "let _ = Volt::base(1u8) * AngularVelocity::base(1u8);",
        "```",
        "",
        "and only values of the same unit add up:",
        "",
        "```compile_fail",
        "use ww_si::{Ampere, Volt};",
        "",
        "let _ = Volt::base(1u8) + Ampere::base(1u8);",
        "```",
    ], ident: "Quantity", generics: [
        (ident: "U", kind: Type),
    ], fields: Named([
        (ident: Some("prefix"), default: None, since: None, ty: OutOfLine(type_idx: 1), docs: [], slot: None, series_opaque: false),
        (ident: Some("value"), default: None, since: None, ty: OutOfLine(type_idx: 2), docs: [], slot: None, series_opaque: false),
    ]), sparse: false, path: None)), crate_idx: 0),
    InLine(ty: Struct((size: UnsizedFinalStructure, crate_idx: 0, docs: [
        "A value with the time it was taken: a sample of a property, an item of a stream (`Timed<Ampere>`,",
        "`Timed<IvSample>`).",
        "",
        "`t` is a device timestamp, as [Second]\'s docs say: the device\'s time since its clock started, at a prefix and",
        "storage that stay the same for a given property or stream (`Second { Micro, U32 }` wraps every 71.6 minutes, the",
        "host gets the full time back with [Unwrapper](crate::Unwrapper)).",
        "",
        "On the wire it is a `final_structure` struct of `t` and then `value`: no fields can be added later. In a",
        "`Series` (`series`, SW-60) `t` is a column like any other: a regular clock costs nothing per item.",
    ], ident: "Timed", generics: [
        (ident: "T", kind: Type),
    ], fields: Named([
        (ident: Some("t"), default: None, since: None, ty: Instance(type_idx: 3, args: [
            Type(OutOfLine(type_idx: 0)),
        ]), docs: [
            "When `value` was taken, device time.",
        ], slot: None, series_opaque: false),
        (ident: Some("value"), default: None, since: None, ty: Param(0), docs: [], slot: None, series_opaque: false),
    ]), sparse: false, path: None)), crate_idx: 0),
