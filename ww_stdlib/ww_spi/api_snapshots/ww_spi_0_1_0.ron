    InLine(level: (docs: [
        "An SPI master: configure the bus, full-duplex transfer, transactions with CS held, and plain writes.",
        "",
        "Several operations under one CS assertion (write a command, then read a response) are one `Spi::transaction`,",
        "not several calls to `Spi::transfer`: releasing CS between them would end the frame.",
    ], crate_idx: 0, trait_name: "Spi", items: [
        (id: 0, kind: Method(args: [
            (ident: "data", ty: MaxLen(max_len: 512, ty: Vec(NumericAny(Base(U8))))),
        ], return_ty: Some(Result(ok_ty: MaxLen(max_len: 512, ty: Vec(NumericAny(Base(U8)))), err_ty: OutOfLine(type_idx: 0)))), multiplicity: Flat, since: None, ident: "transfer", docs: [
            "Full duplex: writes `data`, returns as many bytes as were read. CS is asserted for the call and released",
            "after, as [CsMode::Auto]; with [CsMode::Manual] the bus must already be selected (`Spi::set_cs`).",
            "",
            "# Errors",
            "",
            "[SpiError::WrongMode] (not configured as [SpiRole::Master]), [SpiError::BufferTooBig] (`data` longer than",
            "[SPI_MAX] or this device\'s [SpiCapabilities::max_len]), [SpiError::NoIoLevel], [SpiError::Timeout].",
        ]),
        (id: 1, kind: Method(args: [
            (ident: "ops", ty: MaxLen(max_len: 16, ty: Vec(OutOfLine(type_idx: 2)))),
        ], return_ty: Some(Result(ok_ty: MaxLen(max_len: 512, ty: Vec(NumericAny(Base(U8)))), err_ty: OutOfLine(type_idx: 0)))), multiplicity: Flat, since: None, ident: "transaction", docs: [
            "CS asserted for every op of `ops`, released at the end; returns the bytes of every [SpiOp::Read] and",
            "[SpiOp::Transfer], concatenated in order. [SpiOp::Delay] waits between two ops without touching the lines.",
            "",
            "# Errors",
            "",
            "As `Spi::transfer`; [SpiError::InvalidArgument] (more than [MAX_OPS] operations, or the reads together",
            "exceed [SPI_MAX]).",
        ]),
        (id: 2, kind: Method(args: [
            (ident: "data", ty: MaxLen(max_len: 512, ty: Vec(NumericAny(Base(U8))))),
        ], return_ty: Some(Result(ok_ty: Tuple([]), err_ty: OutOfLine(type_idx: 0)))), multiplicity: Flat, since: None, ident: "write", docs: [
            "Writes `data`, ignoring what comes back.",
            "",
            "# Errors",
            "",
            "As `Spi::transfer`.",
        ]),
        (id: 3, kind: Method(args: [], return_ty: Some(OutOfLine(type_idx: 5))), multiplicity: Flat, since: None, ident: "capabilities", docs: [
            "What this bus supports: frequency range, word sizes, master/slave, IO levels.",
        ]),
        (id: 4, kind: Method(args: [
            (ident: "config", ty: OutOfLine(type_idx: 10)),
        ], return_ty: Some(Result(ok_ty: OutOfLine(type_idx: 11), err_ty: OutOfLine(type_idx: 0)))), multiplicity: Flat, since: None, ident: "configure", docs: [
            "Configures the bus and returns the frequency actually set (the nearest the hardware can do, never above the",
            "one asked for). [SpiRole::Disabled] releases the pins.",
            "",
            "# Errors",
            "",
            "[SpiError::InUse] (the pins or peripheral serve another function), [SpiError::Unsupported] ([SpiRole::Slave],",
            "this `word_bits`, or this [CsMode] on an adapter without it), [SpiError::InvalidArgument] (`freq` or",
            "`word_bits` outside [SpiCapabilities]), [SpiError::Refused] (a safety rule of the device).",
        ]),
        (id: 5, kind: Method(args: [
            (ident: "active", ty: Bool),
        ], return_ty: Some(Result(ok_ty: Tuple([]), err_ty: OutOfLine(type_idx: 0)))), multiplicity: Flat, since: None, ident: "set_cs", docs: [
            "Asserts or releases CS, with [CsMode::Manual].",
            "",
            "# Errors",
            "",
            "[SpiError::WrongMode] (CS isn\'t [CsMode::Manual]).",
        ]),
        (id: 6, kind: Property(ty: OutOfLine(type_idx: 4), access: ReadWrite(observe: false), write_err_ty: Some(OutOfLine(type_idx: 0))), multiplicity: Flat, since: None, ident: "reference_voltage", docs: [
            "IO level, on adapters with level translators. [SpiError::Unsupported] if there is no level control,",
            "[SpiError::Refused] if a safety rule of the device doesn\'t allow the requested level.",
        ]),
    ]), crate_idx: 0),
    InLine(level: (docs: [
        "Watches an SPI bus without taking part: one [SpiFrame] per CS assertion on the `frames` stream.",
    ], crate_idx: 0, trait_name: "SpiMonitor", items: [
        (id: 0, kind: StreamFn(ty: OutOfLine(type_idx: 13), delivery: Counted, args: [
            (ident: "config", ty: OutOfLine(type_idx: 12)),
        ], return_ty: Some(Result(ok_ty: Tuple([]), err_ty: OutOfLine(type_idx: 0)))), multiplicity: Flat, since: None, ident: "frames", docs: [
            "One frame per CS assertion, in bus order, decoded with `config` (the monitor doesn\'t drive CS or clock, it",
            "only listens). Opening starts monitoring, closing stops it. A counted stream, unit: frame; the head\'s time is",
            "when CS was asserted, and the host learns exactly how many frames the device dropped.",
            "",
            "# Errors",
            "",
            "[SpiError::InUse], [SpiError::Unsupported] (this `word_bits`), [SpiError::Refused].",
        ]),
    ]), crate_idx: 0),
