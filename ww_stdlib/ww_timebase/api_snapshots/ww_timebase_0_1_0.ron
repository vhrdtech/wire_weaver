        (id: 1, kind: Method(args: [], return_ty: Some(OutOfLine(type_idx: 3)), errors: None), multiplicity: Flat, since: None, ident: "info", docs: [
            "Static description of this clock: its resolution, what it calls itself, and which [SyncFormat]s it",
